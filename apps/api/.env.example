# --- Settlr API environment ---
NODE_ENV=development
PORT=8787
# Comma-separated web origins allowed to call the API with cookies
WEB_ORIGINS=http://localhost:3000

# Dev (default, zero-install): embedded Postgres (PGlite, WASM). Path is relative or absolute.
# Production (Render / any Postgres): postgres://user:pass@host:5432/settlr
DATABASE_URL=pglite://./.pglite-data

# PayPal sandbox (https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
# Optional: set only after subscribing a webhook at the PayPal developer dashboard.
# Leave blank to reconcile approvals through /v1/deals/:id/approve-callback instead.
PAYPAL_WEBHOOK_ID=

# Secrets (generate: openssl rand -hex 32)
AUTH_SECRET=replace_me_32_bytes_hex
VERIFIER_HMAC_SECRET=replace_me_32_bytes_hex

# Optional: model for contract drafting, evidence adjudication, and explanations.
# Any OpenAI-compatible endpoint works; deterministic checks run without it.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional: Channel3 product search (https://trychannel3.com)
CHANNEL3_API_KEY=

# Public URL of this API
PUBLIC_API_URL=http://localhost:8787
# Where to send the buyer back after sandbox approval
WEB_RETURN_URL=http://localhost:3000/deals/return
WEB_CANCEL_URL=http://localhost:3000/deals/cancel
