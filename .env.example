# Repo-root values used by `docker compose`. This is separate from app-local .env files.
# Copy to .env and replace the PayPal values. Never commit .env.

PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_me
VERIFIER_HMAC_SECRET=replace_me

# Optional: enables the Channel3 product catalog for agent shopping.
CHANNEL3_API_KEY=

# Optional: enables contract drafting, evidence adjudication, and explanations.
# Any OpenAI-compatible endpoint works; deterministic checks settle deals without it.
GROQ_API_KEY=

# Browser-facing settings (must be non-secret)
# Set true only behind HTTPS termination. Local HTTP deployments must use false.
COOKIE_SECURE=false
# Optional host port overrides if 8787/3000 are busy:
# API_PORT=8788
# WEB_PORT=3004
WEB_ORIGINS=http://localhost:3000
WEB_RETURN_URL=http://localhost:3000/deals/return
WEB_CANCEL_URL=http://localhost:3000/deals/cancel
PUBLIC_API_URL=http://localhost:8787

# Sandbox Postgres credentials used only by local Docker Compose.
POSTGRES_USER=settlr
POSTGRES_PASSWORD=settlr_dev_password
POSTGRES_DB=settlr
